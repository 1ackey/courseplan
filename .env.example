# Flask admin panel settings (copy to .env and adjust)

# Session secret for the admin panel
FLASK_SECRET_KEY=change-me-to-a-random-string

# Admin panel login password (REQUIRED on the server)
ADMIN_PASSWORD=change-me

# Where nginx serves the panel: /notebook-admin/ → 127.0.0.1:8766
COURSEPLAN_URL_PREFIX=/notebook-admin
FLASK_HOST=127.0.0.1
FLASK_PORT=8766

# Publish pipeline
# rsync target for the static site (empty = build only, no deploy)
COURSEPLAN_PUBLISH_TARGET=/var/www/jackeywiki/slides/notebook
# commit + push docs changes to GitHub main after each publish
COURSEPLAN_PUBLISH_GIT=1
# apply edits and publish immediately without admin confirmation (mode 1)
COURSEPLAN_AUTO_PUBLISH=1
# public edit links baked into generated pages
COURSEPLAN_EDIT_BASE=/notebook-admin
# GitHub webhook secret (same value configured on the GitHub repo webhook)
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-string
